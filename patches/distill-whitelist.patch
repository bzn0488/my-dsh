+import { KNOWN_SESSION_EVENT_TYPES } from '@deepseek-ai/dsh-session';
+// Register the review-request event type with the harness session vocabulary
+// so persisted logs containing it stay loadable: the persistence read path
+// (dsh-session-persistence assertEventsSupported) refuses any event type
+// outside KNOWN_SESSION_EVENT_TYPES unless the envelope is marked ignorable,
+// and session.append cannot set that marker. This module shares the same Set
+// instance with the persistence layer (both resolve @deepseek-ai/dsh-session
+// to the same file), and runs at plugin load — well before any session log is
+// read — so existing sessions that triggered a distill review become readable
+// again. Keep this list in sync if the plugin ever appends more event types.
+KNOWN_SESSION_EVENT_TYPES.add('session/distill-review-request');
