# ============================================================
# Personal workstation repo — E:\Deepseek Harness
# Everything generated or runtime-transient stays out of git;
# configuration and launchers are tracked.
# ============================================================

# --- Dependency trees (regenerated by pnpm install) ---
node_modules/
**/node_modules/
.pnpm-store/
.pnpm-cache/
.pnpm-state/

# --- DSH runtime state ---
.dsh/sessions/
.dsh/storages/
.dsh/restart.log
*.log

# --- Secrets ---
.dsh/.credentials.yaml
**/.credentials.yaml
.env
.env.*

# --- Agent-generated content ---
# Auto-distilled skills (distill) and third-party skill installs live here.
# Ignored so the repo stays reviewable; see README "Skills" to opt in.
.agents/skills/
