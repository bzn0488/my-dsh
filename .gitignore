# ============================================================
# Personal workstation repo — E:\Deepseek Harness
# Everything generated or runtime-transient stays out of git;
# configuration and launchers are tracked.
# ============================================================

# --- Dependency trees (regenerated by pnpm install) ---
node_modules/
**/node_modules/
.pnpm-store/
.pnpm-cache/
.pnpm-state/

# --- DSH runtime state ---
# NOTE: .dsh/sessions/ and .dsh/storages/ are TRACKED on purpose — the
# workstation's persisted conversation history and memory belong in git.
# Only transient logs stay ignored.
.dsh/restart.log
*.log

# --- Secrets ---
.dsh/.credentials.yaml
**/.credentials.yaml
.env
.env.*

# --- Knowledge-base derived data ---
# The Vault itself (knowledge/) is tracked. These are rebuilt from it.
.dsh/storages/knowledge-base/

# --- Agent-generated content ---
# NOTE: .agents/skills/ is TRACKED on purpose — distilled and hand-authored
# skills are the workstation's accumulated knowledge and belong in git.
